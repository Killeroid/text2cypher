# Generated by scripts/build_requirements.py for deployment
apps/*/requirements.txt
apps/*/email_ingestion/

# Temporary parameter files written by infra/up.sh (removed on exit)
infra/params/.up-*

# Real deployment settings (copy of deploy/appsettings.example.json)
deploy/appsettings.json

# Azure Functions local settings (may contain secrets)
local.settings.json

# Secrets and credentials (match by file type, not by name prefix)
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
!*.pub

# Credential/secret config files (exact names and structured formats)
credentials.json
service-account*.json
client_secret*.json
secrets.json
secrets.yaml
secrets.yml
secrets.toml
.secrets/
.netrc
.pypirc
.npmrc


# Replies and prompts of a trial run (evals/README.md)
evals/work/

# Built documentation (docs/conf.py)
docs/_build/
